# ⚠️  DeepSeek не поддерживает embeddings API (только chat)
# Система использует локальный TF-IDF поиск автоматически
# DEEPSEEK_API_KEY=sk-...  # Опционально, для будущих фич (генерация описаний и т.д.)

# ВАЖНО: Для embeddings требуется использовать:
# - Локальный TF-IDF (встроенный, бесплатный) - текущий вариант
# - OpenAI API (требует ключ) - альтернатива
# - Другой сервис embeddings

# Пример для OpenAI embeddings (если нужны):
# EMBEDDING_SERVICE=openai
# EMBEDDINGS_API_KEY=sk-proj-...
